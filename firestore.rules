rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Start restrictive. Add your authenticated admin UID before production.
    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /orders/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
    match /customers/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}